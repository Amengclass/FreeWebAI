# ai-hub 环境配置（可选，全部有默认值）
# 复制为 .env 使用。已存在的进程环境变量优先。

# 指向 AgentChat 的 skills/lib 目录（必须）。
# 默认自动探测同级 AgentChat\skills\lib；找不到时用此项。
# AGENTCHAT_LIB_PATH=C:\Users\Ameng\Desktop\claude_woker\cc_work\AI牛马\AgentChat\skills\lib

# Chrome CDP（与 AgentChat 共用同一个调试浏览器）
CDP_HOST=127.0.0.1
CDP_PORT=9222

# ai-hub HTTP 接口
HUB_HOST=127.0.0.1
HUB_PORT=8787

# 默认超时（毫秒）
HUB_TIMEOUT_MS=120000          # 单次 chat 总预算（含降级链）
HUB_PROVIDER_TIMEOUT_MS=60000  # 单 provider 预算

# Gemini 快速模式：跳过 Pro Extended 模型激活（省 ~40s 选择器探测），
# 直接用页面默认模型。设 0 关闭（需要深度推理/Pro 时）。
HUB_GEMINI_FAST=1

# 失败记忆（冷却）时长（毫秒）：失败后自动降级链会跳过该 provider 一段时间
HUB_COOLDOWN_TRANSIENT_MS=90000   # 普通失败
HUB_COOLDOWN_QUOTA_MS=300000      # 额度用尽
